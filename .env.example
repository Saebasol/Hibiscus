# Server, local data, and public application URL
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/hibiscus.db
PUBLIC_URL=http://localhost:3000
TRUST_PROXY=false

# Optional OIDC authentication. Set all three connection values to enable it.
OIDC_PROVIDER_NAME=Authentik
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_SCOPES=openid profile email

# Development only: allow an HTTP OIDC issuer and token endpoint.
OIDC_ALLOW_INSECURE=false

# Local mock OIDC development (run `pnpm mock:oidc` in another terminal, then uncomment)
# OIDC_PROVIDER_NAME=Local Mock OIDC
# OIDC_ISSUER_URL=http://127.0.0.1:4100
# OIDC_CLIENT_ID=hibiscus-local
# OIDC_CLIENT_SECRET=hibiscus-local-secret
# OIDC_ALLOW_INSECURE=true
