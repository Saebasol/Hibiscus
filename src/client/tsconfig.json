{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ES2023",
    "types": [
      "vite/client"
    ],
    "baseUrl": "../../",
    "paths": {
      "$app/core.tsx": [
        "./src/client/types/fastify-react.d.ts"
      ]
    }
  },
  "include": [
    "**/*"
  ],
  "exclude": []
}
